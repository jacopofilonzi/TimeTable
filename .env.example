# Copy to `.env` (`make env`). The backend loads it at startup; real environment variables win.
# Docker compose also reads this file for the ${...} substitutions in docker-compose.yml.

# ─── Server ────────────────────────────────────────────────────────────────────
# Plain HTTP: put a reverse proxy in front for HTTPS.
HOST=127.0.0.1
PORT=8080
# Public path prefix, e.g. /timetable when served at https://example.com/timetable/. Empty = root.
BASE_PATH=
# Built frontend directory. Default: /www, then ../frontend/dist (relative to the working dir).
STATIC_DIR=

# ─── Cache ─────────────────────────────────────────────────────────────────────
# Empty = in-memory cache only (default for development).
# With Redis the in-memory cache stays in front of it; Redis adds persistence across restarts.
# Local Redis for development: `make redis-up` and set REDIS_URL=redis://127.0.0.1:6379
REDIS_URL=
# Seconds.
CACHE_LESSONS_TTL=21600
CACHE_OPTIONS_TTL=86400

# ─── Short links ───────────────────────────────────────────────────────────────
# SQLite file for the share links (/s/<code>). Empty = data/shortlinks.db, relative to the working
# dir (backend/data/ with `make dev`); the docker image uses /data/shortlinks.db. `false` disables
# short links. The file and its directory are created if missing; if they can't be written the
# server refuses to start. With docker compose, use `false` or a path inside the container.
SHORTLINK_DB=

# ─── Usage log & metrics ───────────────────────────────────────────────────────
# SQLite file of the usage log: every .ics fetch (feed) and every JSON call from outside the
# wizard (api), with time, track id (`k`, NULL when anonymous), settings, client and status.
# Empty = data/feed_stats.db, relative to the working dir; the docker image uses
# /data/feed_stats.db. `false` disables it (Prometheus counters still work). Like SHORTLINK_DB,
# the server refuses to start if it can't write the file. Keep it separate from SHORTLINK_DB.
FEED_STATS_DB=
# Days of usage log to keep (older rows are purged daily). Empty = 365; 0 = keep forever.
# The per-subscriber summary (feed_subscribers) is always kept.
FEED_STATS_RETENTION_DAYS=
# Read-only token for GET /api/metrics (Prometheus) and GET /api/stats/... (JSON, e.g. Grafana
# Infinity), sent as `Authorization: Bearer <token>`. Empty = those endpoints are disabled (404).
# Use a different value than AUTH_TOKEN, e.g. `openssl rand -hex 32`. See grafana/README.md.
STATS_TOKEN=

# ─── Admin ─────────────────────────────────────────────────────────────────────
# Token for the admin endpoints (e.g. DELETE /api/admin/cache) and the /admin/ page, sent as
# `Authorization: Bearer <token>`. Empty = admin endpoints disabled (they answer 404).
# Use a long random value, e.g. `openssl rand -hex 32`.
AUTH_TOKEN=

# ─── Logging ───────────────────────────────────────────────────────────────────
# See https://docs.rs/tracing-subscriber/latest/tracing_subscriber/filter/struct.EnvFilter.html
RUST_LOG=info,timetable=debug
# pretty | compact | json
LOG_FORMAT=pretty

# ─── Docker compose only ───────────────────────────────────────────────────────
# Redis password (URL-safe characters only, it ends up in REDIS_URL).
REDIS_PASSWORD=change-me
# Host port the container is published on.
PUBLISH_PORT=8080
