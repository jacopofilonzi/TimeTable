---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout lang="it">
  <div class="px-6 py-16 text-center">
    <img src={`${base}/logo.png`} alt="" class="mx-auto h-12 w-12" width="48" height="48" />
    <p class="mt-6 font-mono text-5xl font-bold text-neutral-300">404</p>
    <p class="mt-4 text-neutral-600">Pagina non trovata · Page not found</p>
    <a href={`${base}/`} class="btn-primary mt-6">Home</a>
  </div>
</Layout>
